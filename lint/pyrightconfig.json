{
  "pythonVersion": "3.11",
  "venvPath": "../.tools",
  "venv": "lint",
  "typeCheckingMode": "basic",
  "include": [
    "../scripts",
    "../tests",
    "../skills"
  ],
  "exclude": [
    "../piw",
    "../tests/skill-evals/**/fixture",
    "../scripts/render_serena_config.py",
    "**/__pycache__"
  ],
  "executionEnvironments": [
    {
      "root": "../tests",
      "extraPaths": [
        "../tests/skill-evals"
      ]
    },
    {
      "root": "../skills/clean-stale-worktrees/scripts",
      "pythonVersion": "3.10"
    },
    {
      "root": "../skills/plc-feature-start/scripts",
      "pythonVersion": "3.10"
    }
  ]
}
